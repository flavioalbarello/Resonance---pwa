<?xml version="1.0" encoding="utf-8"?>
<!-- Il Ritratto di Adam sulla schermata principale (battito/Widget.kt): l'immagine del giorno e una riga di legenda. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp">
    <ImageView
        android:id="@+id/widget_immagine"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:contentDescription="Il ritratto di Adam" />
    <TextView
        android:id="@+id/widget_riga"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#FF6E6A5C"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
